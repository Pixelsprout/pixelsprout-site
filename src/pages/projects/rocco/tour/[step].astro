---
import { render } from 'astro:content';
import Tour from '../../../../layouts/Tour.astro';
import { getDocs, getTour, getTourSteps, type TourStepEntry } from '../../../../lib/content';
import { TOUR_BASE } from '../../../../lib/tour';
import { DEFAULT_LAYOUT, template } from '../../../../lib/tour-panes';
import { tourUrl } from '../../../../lib/tour-steps';

type Link = { slug: string; title: string };
type Props =
  | { kind: 'step'; step: TourStepEntry; base: string; previous?: Link; next?: Link }
  | { kind: 'unavailable'; title: string; message: string };

export async function getStaticPaths() {
  const tour = await getTour();
  if (tour.available) {
    const steps = await getTourSteps();
    const link = (step?: TourStepEntry) => step && { slug: step.data.slug, title: step.data.title };
    return steps.map((step, i) => ({
      params: { step: step.data.slug },
      props: { kind: 'step' as const, step, base: tour.base, previous: link(steps[i - 1]), next: link(steps[i + 1]) },
    }));
  }
  // Keeps the step URLs alive, so a bookmark explains why there is no Tour.
  const { pages } = await getDocs();
  return pages
    .filter((page) => page.slug.startsWith('tutorial/'))
    .map((page) => ({
      params: { step: page.slug.slice('tutorial/'.length) },
      props: { kind: 'unavailable' as const, title: page.title, message: tour.message },
    }));
}

const props = Astro.props;
const step = props.kind === 'step' ? props.step : null;
const { Content } = step ? await render(step) : { Content: null };
// Escapes "<" so a source with </script> cannot end the data block.
const grid = template(DEFAULT_LAYOUT);
const gridStyle = `--tour-columns: ${grid.columns}; --work-rows: ${grid.rows}`;
const sources = step && JSON.stringify({ slug: step.data.slug, start: step.data.start, answer: step.data.answer }).replace(/</g, '\\u003c');
---
{props.kind === 'unavailable' ? (
  <Tour title={props.title} description="The rocco Tour is not available for this release.">
    <main class="unavailable">
      <h1>{props.title}</h1>
      <p>{props.message}.</p>
      <p><a class="tap" href="/projects/rocco/docs/">Read the Guide</a></p>
    </main>
  </Tour>
) : (
  <Tour title={props.step.data.title} description={`A step of the rocco Tour: ${props.step.data.title}`}>
    <div class="tour" style={gridStyle} data-base={props.base}>
      <div class="side" data-pane="lesson">
        <article class="lesson prose pane-body" id="tour-lesson">{Content && <Content />}</article>
        <nav class="nav" aria-label="Tour steps">
          <button type="button" class="pane-toggle" data-toggle="lesson" aria-controls="tour-lesson" aria-expanded="true" aria-label="Collapse the lesson">-</button>
          {props.previous && <a class="tap" rel="prev" href={tourUrl(props.previous.slug)}>&lt; {props.previous.title}</a>}
          <a class="tap contents" href={TOUR_BASE}>Contents</a>
          {props.next && <a class="tap next" rel="next" href={tourUrl(props.next.slug)}>{props.next.title} &gt;</a>}
        </nav>
        <div class="edge" data-edge="lesson" role="separator" aria-orientation="vertical" aria-label="Resize the lesson" tabindex="0"></div>
      </div>

      <div class="work">
        <section class="editor-pane" data-pane="editor" aria-label="Editor">
          <div class="toolbar">
            <button type="button" class="pane-toggle" data-toggle="editor" aria-controls="tour-editor" aria-expanded="true" aria-label="Collapse the editor">-</button>
            <span class="file">main.roc</span>
            <span class="spacer"></span>
            <button type="button" data-action="run" title="Run (Cmd/Ctrl+Enter)">Run</button>
            <button type="button" data-action="reset">Reset</button>
            <button type="button" data-action="answer">Show answer</button>
          </div>
          <div class="editor pane-body" id="tour-editor"></div>
        </section>

        <section class="panel" data-pane="panel" aria-label="Problems and Console">
          <div class="edge" data-edge="panel" role="separator" aria-orientation="horizontal" aria-label="Resize the panel" tabindex="0"></div>
          <div class="bar">
            <button type="button" class="pane-toggle" data-toggle="panel" aria-controls="tour-panel" aria-expanded="true" aria-label="Collapse the panel">-</button>
            <span>Problems <b class="count" id="tour-problem-count"></b></span>
          </div>
          <div class="panel-body pane-body" id="tour-panel"></div>
        </section>

        <section class="preview" data-pane="preview" aria-label="Preview">
          <div class="edge" data-edge="preview" role="separator" aria-orientation="horizontal" aria-label="Resize the Preview" tabindex="0"></div>
          <div class="bar">
            <button type="button" class="pane-toggle" data-toggle="preview" aria-controls="tour-stage" aria-expanded="true" aria-label="Collapse the Preview">-</button>
            <span>Preview</span>
            <span class="spacer"></span>
            <span class="status" id="tour-status" aria-live="polite"></span>
            <button type="button" data-action="expand" aria-pressed="false">Expand</button>
          </div>
          <div class="stage pane-body" id="tour-stage"><p class="note">The game runs here.</p></div>
        </section>
      </div>
    </div>
    <script type="application/json" id="tour-step" set:html={sources} />
  </Tour>
)}

<script>
  import { mountTourEditor } from '../../../../lib/tour-editor';
  import { mountTourPanes } from '../../../../lib/tour-pane-ui';

  import { mountTourRun } from '../../../../lib/tour-run-ui';

  const tour = document.querySelector<HTMLElement>('.tour');
  const panes = tour && mountTourPanes(tour);

  const data = document.getElementById('tour-step');
  const host = document.getElementById('tour-editor');
  if (tour && panes && data && host) {
    const editor = await mountTourEditor(host, JSON.parse(data.textContent!));
    document.querySelector('[data-action="reset"]')!.addEventListener('click', () => editor.reset());
    document.querySelector('[data-action="answer"]')!.addEventListener('click', () => editor.showAnswer());
    const byId = (id: string) => document.getElementById(id)!;
    mountTourRun(tour.dataset.base!, editor, panes, {
      stage: byId('tour-stage'),
      status: byId('tour-status'),
      panel: byId('tour-panel'),
      count: byId('tour-problem-count'),
      run: document.querySelector<HTMLElement>('[data-action="run"]')!,
    });
  }
</script>

<style is:global>
  html:has(.tour), html:has(.tour) body { height: 100%; overflow: hidden; }
</style>

<style>
  .unavailable { max-width: 700px; margin: 0 auto; padding: 64px 24px; display: flex; flex-direction: column; gap: 16px; }
  .unavailable p { margin: 0; }
  .tour {
    height: 100vh;
    height: 100dvh;
    display: grid;
    gap: 1px;
    background: var(--edge);
    grid-template-columns: var(--tour-columns);
  }
  .tour > *, .work > * { background: var(--soil); min-width: 0; min-height: 0; }
  .tour[data-dragging] { user-select: none; }
  .tour[data-dragging] :global(iframe) { pointer-events: none; }
  .side { position: relative; display: grid; grid-template-rows: 1fr auto; }
  .lesson { overflow: auto; padding: 24px 32px; font-size: 15px; }
  .lesson :global(h1) { font-size: 40px; }
  .nav { display: flex; align-items: center; gap: 16px; padding: 0 16px; font-size: 14px; background: var(--soil-bar); }
  .nav .next { margin-left: auto; text-align: right; }
  .work { display: grid; gap: 1px; background: var(--edge); grid-template-rows: var(--work-rows); align-content: start; }
  .editor-pane, .panel, .preview { position: relative; display: grid; grid-template-rows: auto 1fr; }
  .toolbar, .bar { display: flex; gap: 8px; align-items: center; padding: 6px 10px; background: var(--soil-bar); font-size: 13px; }
  .bar { padding: 4px 10px; }
  .spacer { flex: 1; }
  .toolbar button, .bar button, .nav button {
    font: inherit;
    font-size: 13px;
    background: var(--soil-raised);
    color: var(--text);
    border: 1px solid var(--edge);
    padding: 3px 10px;
    cursor: pointer;
  }
  .pane-toggle { min-width: 28px; }
  .editor { min-height: 0; }
  .panel-body { overflow: auto; background: var(--soil-deep); font-size: 13px; }
  .stage { position: relative; background: #000; display: grid; place-items: center; }
  .note { margin: 0; padding: 16px; max-width: 480px; text-align: center; color: var(--text-muted); }
  .status { color: var(--text-muted); }
  .count:empty { display: none; }
  .stage :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  /* Not visibility: hidden, so the new Preview still draws its first frame behind the old one. */
  .stage :global(iframe.starting) { opacity: 0; pointer-events: none; }
  .panel-body :global(.problems) { list-style: none; margin: 0; padding: 0; }
  .panel-body :global(.problems li) { border-bottom: 1px solid var(--edge); }
  .panel-body :global(.problems .head) {
    display: flex;
    gap: 12px;
    width: 100%;
    padding: 6px 12px;
    font: inherit;
    text-align: left;
    color: var(--text);
    background: none;
    border: 0;
  }
  .panel-body :global(button.head) { cursor: pointer; }
  .panel-body :global(button.head:hover) { background: var(--soil-raised); }
  .panel-body :global(.problems .where) { color: var(--text-muted); }
  .panel-body :global(.problems .title) { font-weight: 600; }
  .panel-body :global(.problems pre) { margin: 0; padding: 0 12px 8px; font-size: 12px; white-space: pre; overflow-x: auto; }

  [data-collapsed] > .pane-body { display: none; }
  .side[data-collapsed] { grid-template-rows: 1fr; }
  .side[data-collapsed] .nav { align-items: end; padding: 8px 4px; }
  .side[data-collapsed] .nav a { display: none; }

  /* The edge sits over the border between two panes, so it takes no grid track. */
  .edge { position: absolute; z-index: 2; touch-action: none; }
  .edge:hover, .edge:focus-visible { background: var(--sprout); outline: none; }
  [data-edge='lesson'] { top: 0; bottom: 0; right: -4px; width: 7px; cursor: col-resize; }
  .side[data-collapsed] [data-edge='lesson'] { display: none; }
  [data-edge='panel'], [data-edge='preview'] { left: 0; right: 0; top: -4px; height: 7px; cursor: row-resize; }
  .edge[hidden] { display: none; }

  .tour[data-expanded] .preview { position: fixed; inset: 0; z-index: 10; }
  .tour[data-expanded] .preview > .pane-body { display: grid; }
  .tour[data-expanded] .preview .pane-toggle, .tour[data-expanded] .preview .edge { display: none; }

  @media (max-width: 800px) {
    :global(html:has(.tour)), :global(html:has(.tour) body) { overflow: auto; }
    .tour { height: auto; grid-template-columns: 1fr; }
    .work { grid-template-rows: auto; }
    .lesson { padding: 20px 16px; }
    .nav { flex-wrap: wrap; padding: 8px 16px; }
    .side[data-collapsed] .nav a { display: inline-flex; }
    .editor-pane:not([data-collapsed]) { height: 60vh; }
    .panel:not([data-collapsed]) { height: 160px; }
    .preview:not([data-collapsed]) { height: 38vh; }
    .edge { display: none; }
  }
</style>
