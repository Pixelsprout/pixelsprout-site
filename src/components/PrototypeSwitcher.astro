---
// PROTOTYPE: throwaway variant switcher. Never rendered in production builds.
type Props = { variants: { key: string; name: string }[] };
const { variants } = Astro.props;
---
{!import.meta.env.PROD && (
  <div class="proto-switcher" data-variants={JSON.stringify(variants)}>
    <button type="button" data-step="-1" aria-label="Previous variant">&larr;</button>
    <span class="label"></span>
    <button type="button" data-step="1" aria-label="Next variant">&rarr;</button>
  </div>
)}

<script>
  const bar = document.querySelector<HTMLElement>('.proto-switcher');
  if (bar) {
    const variants: { key: string; name: string }[] = JSON.parse(bar.dataset.variants!);
    const label = bar.querySelector<HTMLElement>('.label')!;
    const current = () => {
      const key = new URL(location.href).searchParams.get('variant') ?? variants[0].key;
      return Math.max(0, variants.findIndex((v) => v.key === key));
    };
    const apply = (i: number) => {
      const v = variants[i];
      const url = new URL(location.href);
      url.searchParams.set('variant', v.key);
      history.replaceState(null, '', url);
      label.textContent = `${v.key} (${v.name})`;
      document.dispatchEvent(new CustomEvent('proto:variant', { detail: v.key }));
    };
    const step = (d: number) => apply((current() + d + variants.length) % variants.length);
    bar.addEventListener('click', (e) => {
      const d = (e.target as HTMLElement).closest('button')?.dataset.step;
      if (d) step(Number(d));
    });
    addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('input, textarea, [contenteditable], .monaco-editor')) return;
      if (e.key === 'ArrowLeft') step(-1);
      if (e.key === 'ArrowRight') step(1);
    });
    apply(current());
  }
</script>

<style>
  .proto-switcher {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 10px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    font: 600 13px/1 system-ui, sans-serif;
    box-shadow: 0 4px 18px rgb(0 0 0 / 0.5);
  }
  .proto-switcher button {
    border: 0;
    background: #111;
    color: #fff;
    border-radius: 999px;
    width: 28px;
    height: 28px;
    cursor: pointer;
  }
</style>
